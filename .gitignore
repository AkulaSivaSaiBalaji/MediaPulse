# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets
.env
.env.local
*.pem
*.key

# Jupyter Notebook Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Pytest cache
.pytest_cache/
.coverage
htmlcov/
.matplotlib_cache/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Datasets - Ignore large raw files, preserve directory with .gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# System & OS Files
Thumbs.db
Desktop.ini
.DS_Store
